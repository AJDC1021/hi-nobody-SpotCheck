{
  "expo": {
    "name": "SpotCheck",
    "slug": "spotcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "backgroundColor": "#121212",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.ajdc2021.spotcheck"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SpotCheck needs your location to detect when you enter a store.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SpotCheck needs background location for store entry alerts.",
        "NSLocationAlwaysUsageDescription": "SpotCheck needs background location for store entry alerts.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SpotCheck needs your location to detect when you enter a store.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "3be78b2e-d86b-4ac2-88e5-11e6c106e54e"
      }
    }
  }
}
